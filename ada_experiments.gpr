with "raylib.gpr";
with "config/ada_experiments_config.gpr";
project Ada_Experiments is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Ada_Experiments_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("ada_experiments.adb", "raylib_check.adb");

   package Compiler is
      for Default_Switches ("Ada") use Ada_Experiments_Config.Ada_Compiler_Switches & ("-gnat2022");
   end Compiler;

   package Linker is
      for Switches ("Ada") use
        ("-lraylib", "-lm", "-lopengl32", "-lgdi32", "-lwinmm", "-mwindows");
   end Linker;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Ada_Experiments;



